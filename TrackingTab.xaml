<UserControl x:Class="GameHelper.TrackingTab"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="200"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Левая панель: список сессий -->
        <DockPanel Grid.Column="0" Margin="0,0,8,0" LastChildFill="True">
            <TextBlock DockPanel.Dock="Top" Text="Сессии" FontWeight="Bold" Margin="0,0,0,6"/>
            <StackPanel DockPanel.Dock="Top" Margin="0,0,0,6">
                <TextBox x:Name="TxtNewSession" Margin="0,0,0,4"/>
                <Button Content="+ Создать сессию" Click="BtnCreateSession_Click"/>
            </StackPanel>
            <Button DockPanel.Dock="Bottom" Content="Удалить сессию" Margin="0,4,0,0"
                    Click="BtnDeleteSession_Click"/>
            <ListBox x:Name="SessionsList" SelectionChanged="SessionsList_SelectionChanged"/>
        </DockPanel>

        <!-- Правая панель -->
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Импорт снимка + список снимков -->
            <StackPanel Grid.Row="0" Margin="0,0,0,8">
                <!-- Авто-листнер -->
                <DockPanel Margin="0,0,0,6">
                    <Button x:Name="BtnListenerToggle" Content="▶ Слушать" Width="90"
                            Click="BtnListenerToggle_Click" DockPanel.Dock="Left" Padding="6,3"/>
                    <Button x:Name="BtnCommitSnapshot" Content="Снимок" Width="70"
                            Click="BtnCommitSnapshot_Click" DockPanel.Dock="Left"
                            Margin="4,0,0,0" Padding="6,3" IsEnabled="False"
                            Background="#E8F5E9" FontWeight="Bold"/>
                    <Button x:Name="BtnDiscardBatches" Content="Сбросить" Width="70"
                            Click="BtnDiscardBatches_Click" DockPanel.Dock="Left"
                            Margin="4,0,0,0" Padding="6,3" Visibility="Collapsed"
                            Foreground="#AA2200"/>
                    <TextBlock x:Name="TxtListenerStatus" VerticalAlignment="Center"
                               Margin="8,0,0,0" Foreground="#555555" FontSize="11"
                               Text="Листнер выключен"/>
                </DockPanel>

                <Expander x:Name="ImportExpander"
                          Header="Добавить снимок (DevTools JSON)" Margin="0,0,0,4">
                    <StackPanel Margin="4,4,0,0">
                        <TextBox x:Name="TxtImportJson"
                                 AcceptsReturn="True" TextWrapping="Wrap"
                                 Height="100" VerticalScrollBarVisibility="Auto"
                                 FontFamily="Consolas" FontSize="11"/>
                        <DockPanel Margin="0,4,0,0">
                            <TextBlock x:Name="TxtImportStatus" DockPanel.Dock="Right"
                                       VerticalAlignment="Center" Margin="8,0,0,0" Foreground="DarkGreen"/>
                            <Button Content="Импортировать" Click="BtnImport_Click"
                                    HorizontalAlignment="Left" Padding="12,4"/>
                        </DockPanel>
                    </StackPanel>
                </Expander>
                <Expander x:Name="SnapshotsExpander" Header="Снимки сессии" Margin="0,0,0,0">
                    <ItemsControl x:Name="SnapshotsList" Margin="4,4,0,0">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <DockPanel Margin="0,1">
                                    <Button DockPanel.Dock="Right" Content="✕" Padding="6,1"
                                            Tag="{Binding}" Click="BtnDeleteSnapshot_Click"
                                            Foreground="#AA2200" FontWeight="Bold"/>
                                    <TextBlock Text="{Binding DisplayLabel}" VerticalAlignment="Center"
                                               FontFamily="Consolas" FontSize="11"/>
                                </DockPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </Expander>
            </StackPanel>

            <!-- Фильтры -->
            <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,6">
                <TextBlock Text="Фильтр: " VerticalAlignment="Center"/>
                <Button x:Name="BtnFilterAll"       Content="Все"         Margin="2,0" Padding="8,2" Click="FilterBtn_Click" Tag="Все"/>
                <Button x:Name="BtnFilterGone"      Content="Ушли"        Margin="2,0" Padding="8,2" Click="FilterBtn_Click" Tag="Ушли"/>
                <Button x:Name="BtnFilterReturned"  Content="Вернулись"   Margin="2,0" Padding="8,2" Click="FilterBtn_Click" Tag="Вернулись"/>
                <Button x:Name="BtnFilterNew"       Content="Новые"       Margin="2,0" Padding="8,2" Click="FilterBtn_Click" Tag="Новые"/>
                <Button x:Name="BtnFilterLingering" Content="Висят"       Margin="2,0" Padding="8,2" Click="FilterBtn_Click" Tag="Висят"/>
            </StackPanel>

            <!-- Таблица предметов -->
            <DataGrid Grid.Row="2" x:Name="RowsGrid"
                      AutoGenerateColumns="False" IsReadOnly="True"
                      SelectionMode="Single" GridLinesVisibility="Horizontal"
                      AlternatingRowBackground="#F9F9F9" CanUserSortColumns="True"
                      SelectionChanged="RowsGrid_SelectionChanged">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Статус"  Binding="{Binding StatusLabel}" Width="170"/>
                    <DataGridTextColumn Header="Цена"    Binding="{Binding PriceLabel}"  Width="80"/>
                    <DataGridTextColumn Header="Δ"       Binding="{Binding PriceDeltaLabel}" Width="70">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding PriceDeltaDir}" Value="Up">
                                        <Setter Property="Foreground" Value="#006600"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding PriceDeltaDir}" Value="Down">
                                        <Setter Property="Foreground" Value="#CC2200"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>
                    <DataGridTextColumn Header="Имя"     Binding="{Binding Name}"         Width="*"/>
                    <DataGridTextColumn Header="Снимки"  Binding="{Binding PresenceStr}"  Width="Auto"
                                        FontFamily="Consolas"/>
                </DataGrid.Columns>
                <DataGrid.RowStyle>
                    <Style TargetType="DataGridRow">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding StatusColor}" Value="Gone">
                                <Setter Property="Foreground" Value="#CC2200"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding StatusColor}" Value="New">
                                <Setter Property="Foreground" Value="#006600"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding StatusColor}" Value="Returned">
                                <Setter Property="Foreground" Value="#0055AA"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding StatusColor}" Value="Lingering">
                                <Setter Property="Foreground" Value="#AA6600"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </DataGrid.RowStyle>
            </DataGrid>

            <!-- Детальная панель -->
            <Border Grid.Row="3" x:Name="DetailPanel" Visibility="Collapsed"
                    BorderBrush="#CCCCCC" BorderThickness="0,1,0,0"
                    Background="#FAFAFA" MaxHeight="320">
                <DockPanel Margin="10,8">
                    <DockPanel DockPanel.Dock="Top" Margin="0,0,0,6">
                        <Button DockPanel.Dock="Right" Content="Закрыть" Padding="8,2"
                                Click="BtnCloseDetail_Click"/>
                        <TextBlock x:Name="TxtDetailHeader" FontWeight="Bold" FontSize="13"/>
                    </DockPanel>
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <ItemsControl x:Name="DetailModsList">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Text}" Foreground="{Binding Color}"
                                               FontFamily="Consolas" FontSize="12" Margin="0,1"/>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </DockPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>
