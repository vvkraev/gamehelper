<Window x:Class="GameHelper.PipelineStepDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Шаг пайплайна"
        Height="530"
        Width="490"
        MinHeight="420"
        MinWidth="420"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False">

    <DockPanel Margin="14">

        <!-- OK / Отмена -->
        <StackPanel DockPanel.Dock="Bottom"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Margin="0,10,0,0">
            <Button Content="OK"      Width="84" Margin="0,0,8,0" IsDefault="True" Click="OkBtn_Click"/>
            <Button Content="Отмена"  Width="84" IsCancel="True"/>
        </StackPanel>

        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel>

                <!-- Название -->
                <TextBlock Text="Название шага" FontWeight="SemiBold" Margin="0,0,0,3"/>
                <TextBox x:Name="StepNameBox" Margin="0,0,0,10" Padding="4,3"/>

                <!-- Действие -->
                <TextBlock Text="Действие" FontWeight="SemiBold" Margin="0,0,0,3"/>
                <ComboBox x:Name="ActionCombo" Margin="0,0,0,10"
                          SelectionChanged="ActionCombo_SelectionChanged">
                    <ComboBoxItem Content="CheckItem — проверить предмет (Ctrl+Alt+C)"/>
                    <ComboBoxItem Content="ChaosCraft — цикл Chaos Orb"/>
                    <ComboBoxItem Content="AugAnnulCraft — цикл Aug + Annul"/>
                    <ComboBoxItem Content="DivineCraft — цикл Divine Orb"/>
                    <ComboBoxItem Content="ExaltCraft — цикл Exalted Orb"/>
                    <ComboBoxItem Content="SimpleExalt — применить экзальт один раз"/>
                    <ComboBoxItem Content="SimpleAnnul — применить аннуль один раз"/>
                    <ComboBoxItem Content="SimpleChaos — применить хаос один раз"/>
                    <ComboBoxItem Content="OmenActivation — переложить омен и активировать"/>
                    <ComboBoxItem Content="DeliriumLiquid — применить масло делириума"/>
                    <ComboBoxItem Content="ManualPause — пауза (успех без действий)"/>
                    <ComboBoxItem Content="TravelToLocation — переход между локациями через Waypoint"/>
                </ComboBox>

                <!-- Максимум итераций -->
                <TextBlock Text="Максимум итераций (MaxIterations)" FontWeight="SemiBold" Margin="0,0,0,3"/>
                <TextBox x:Name="MaxIterBox" Width="100" HorizontalAlignment="Left"
                         Margin="0,0,0,10" Padding="4,3" Text="100"/>

                <!-- OmenConfig (только для OmenActivation) -->
                <Border x:Name="OmenConfigPanel"
                        Visibility="Collapsed"
                        BorderBrush="#BBBBBB"
                        BorderThickness="1"
                        CornerRadius="4"
                        Padding="10,8"
                        Margin="0,0,0,10"
                        Background="#F8F8F8">
                    <StackPanel>
                        <TextBlock Text="Конфигурация омена" FontWeight="SemiBold" Margin="0,0,0,6"/>
                        <TextBlock Text="Ячейки омена берутся из уже настроенных областей (Настройки областей → Omen Sinistral/Dextral/Greater)."
                                   FontSize="11" Foreground="#666" TextWrapping="Wrap" Margin="0,0,0,6"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="160"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="30"/>
                                <RowDefinition Height="30"/>
                                <RowDefinition Height="30"/>
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0" Text="Омен:" VerticalAlignment="Center"/>
                            <ComboBox  Grid.Row="0" Grid.Column="1" x:Name="OmenNameCombo" Margin="0,3"/>

                            <TextBlock Grid.Row="1" Text="Инвентарь строка (0=верх):" VerticalAlignment="Center"/>
                            <TextBox   Grid.Row="1" Grid.Column="1" x:Name="OmenInvRowBox" Text="0" Width="60"
                                       HorizontalAlignment="Left" Margin="0,3" Padding="4,2"/>

                            <TextBlock Grid.Row="2" Text="Инвентарь столбец (0=лево):" VerticalAlignment="Center"/>
                            <TextBox   Grid.Row="2" Grid.Column="1" x:Name="OmenInvColBox" Text="0" Width="60"
                                       HorizontalAlignment="Left" Margin="0,3" Padding="4,2"/>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- DeliriumLiquidConfig (только для DeliriumLiquid) -->
                <Border x:Name="DeliriumLiquidConfigPanel"
                        Visibility="Collapsed"
                        BorderBrush="#BBBBBB"
                        BorderThickness="1"
                        CornerRadius="4"
                        Padding="10,8"
                        Margin="0,0,0,10"
                        Background="#F8F8F8">
                    <StackPanel>
                        <TextBlock Text="Конфигурация масла делириума" FontWeight="SemiBold" Margin="0,0,0,6"/>
                        <TextBlock Text="Выберите масло из списка настроенных предметов делириума."
                                   FontSize="11" Foreground="#666" TextWrapping="Wrap" Margin="0,0,0,6"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="160"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Row="0" Text="Масло делириума:" VerticalAlignment="Center"/>
                            <ComboBox  Grid.Row="0" Grid.Column="1" x:Name="DeliriumLiquidCombo"
                                       Margin="0,3" DisplayMemberPath="DisplayName"/>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- TravelToLocationConfig (только для TravelToLocation) -->
                <Border x:Name="TravelConfigPanel"
                        Visibility="Collapsed"
                        BorderBrush="#BBBBBB"
                        BorderThickness="1"
                        CornerRadius="4"
                        Padding="10,8"
                        Margin="0,0,0,10"
                        Background="#F8F8F8">
                    <StackPanel>
                        <TextBlock Text="Конфигурация перехода через Waypoint" FontWeight="SemiBold" Margin="0,0,0,6"/>
                        <TextBlock FontSize="11" Foreground="#666" TextWrapping="Wrap" Margin="0,0,0,8"
                                   Text="Область поиска Waypoint — прямоугольник, в котором OCR ищет надпись «Waypoint» на экране. Кнопка локации — фиксированные координаты нужного пункта перехода."/>

                        <!-- Область поиска Waypoint -->
                        <TextBlock Text="Область поиска «Waypoint»" FontWeight="SemiBold" Margin="0,0,0,4"/>
                        <Grid Margin="0,0,0,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="60"/>
                                <ColumnDefinition Width="70"/>
                                <ColumnDefinition Width="60"/>
                                <ColumnDefinition Width="70"/>
                                <ColumnDefinition Width="60"/>
                                <ColumnDefinition Width="70"/>
                                <ColumnDefinition Width="60"/>
                                <ColumnDefinition Width="70"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="X:" VerticalAlignment="Center"/>
                            <TextBox   Grid.Column="1" x:Name="TravelWpX" Text="0" Margin="0,2" Padding="4,2"/>
                            <TextBlock Grid.Column="2" Text="Y:" VerticalAlignment="Center" Margin="4,0,0,0"/>
                            <TextBox   Grid.Column="3" x:Name="TravelWpY" Text="0" Margin="0,2" Padding="4,2"/>
                            <TextBlock Grid.Column="4" Text="Шир.:" VerticalAlignment="Center" Margin="4,0,0,0"/>
                            <TextBox   Grid.Column="5" x:Name="TravelWpW" Text="400" Margin="0,2" Padding="4,2"/>
                            <TextBlock Grid.Column="6" Text="Выс.:" VerticalAlignment="Center" Margin="4,0,0,0"/>
                            <TextBox   Grid.Column="7" x:Name="TravelWpH" Text="200" Margin="0,2" Padding="4,2"/>
                        </Grid>
                        <Button x:Name="TravelPickWaypointAreaBtn"
                                Content="🖱 Выделить область Waypoint…"
                                HorizontalAlignment="Left" Padding="8,4" Margin="0,0,0,10"
                                Click="TravelPickWaypointAreaBtn_Click"/>

                        <!-- Кнопка локации -->
                        <TextBlock Text="Область кнопки перехода к локации" FontWeight="SemiBold" Margin="0,0,0,4"/>
                        <Grid Margin="0,0,0,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="60"/>
                                <ColumnDefinition Width="70"/>
                                <ColumnDefinition Width="60"/>
                                <ColumnDefinition Width="70"/>
                                <ColumnDefinition Width="60"/>
                                <ColumnDefinition Width="70"/>
                                <ColumnDefinition Width="60"/>
                                <ColumnDefinition Width="70"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="X:" VerticalAlignment="Center"/>
                            <TextBox   Grid.Column="1" x:Name="TravelLocX" Text="0" Margin="0,2" Padding="4,2"/>
                            <TextBlock Grid.Column="2" Text="Y:" VerticalAlignment="Center" Margin="4,0,0,0"/>
                            <TextBox   Grid.Column="3" x:Name="TravelLocY" Text="0" Margin="0,2" Padding="4,2"/>
                            <TextBlock Grid.Column="4" Text="Шир.:" VerticalAlignment="Center" Margin="4,0,0,0"/>
                            <TextBox   Grid.Column="5" x:Name="TravelLocW" Text="100" Margin="0,2" Padding="4,2"/>
                            <TextBlock Grid.Column="6" Text="Выс.:" VerticalAlignment="Center" Margin="4,0,0,0"/>
                            <TextBox   Grid.Column="7" x:Name="TravelLocH" Text="40" Margin="0,2" Padding="4,2"/>
                        </Grid>
                        <Button x:Name="TravelPickLocBtn"
                                Content="🖱 Выделить область кнопки локации…"
                                HorizontalAlignment="Left" Padding="8,4" Margin="0,0,0,10"
                                Click="TravelPickLocBtn_Click"/>

                        <!-- Задержки -->
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="220"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="30"/>
                                <RowDefinition Height="30"/>
                            </Grid.RowDefinitions>
                            <TextBlock Grid.Row="0" Text="Задержка после Waypoint (мс):" VerticalAlignment="Center"/>
                            <TextBox   Grid.Row="0" Grid.Column="1" x:Name="TravelWpDelayBox" Text="10000"
                                       Width="80" HorizontalAlignment="Left" Margin="0,3" Padding="4,2"/>
                            <TextBlock Grid.Row="1" Text="Задержка загрузки (мс):" VerticalAlignment="Center"/>
                            <TextBox   Grid.Row="1" Grid.Column="1" x:Name="TravelLoadDelayBox" Text="15000"
                                       Width="80" HorizontalAlignment="Left" Margin="0,3" Padding="4,2"/>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- Условия: EntryCondition / LoopUntil -->
                <TextBlock Text="Условия" FontWeight="SemiBold" Margin="0,0,0,6"/>
                <StackPanel Orientation="Horizontal" Margin="0,0,0,2">
                    <Button x:Name="EditEntryBtn" Content="✎ EntryCondition…" Padding="8,4"
                            Margin="0,0,6,0" Click="EditEntryBtn_Click"
                            ToolTip="Условие, проверяемое ДО действия. Если не выполнено → OnFailure."/>
                    <Button x:Name="ClearEntryBtn" Content="✕" Padding="8,4" Margin="0,0,6,0"
                            Click="ClearEntryBtn_Click" ToolTip="Убрать EntryCondition — шаг выполняется всегда"/>
                    <Button x:Name="CopyEntryBtn" Content="Копировать" Padding="8,4" Margin="0,0,6,0"
                            Click="CopyEntryBtn_Click" ToolTip="Скопировать EntryCondition в буфер"/>
                    <Button x:Name="PasteEntryBtn" Content="Вставить" Padding="8,4"
                            Click="PasteEntryBtn_Click" ToolTip="Вставить условие из буфера в EntryCondition"/>
                </StackPanel>
                <CheckBox x:Name="EntryNegateChk" Content="НЕ (инвертировать результат)"
                          Margin="0,2,0,4"
                          ToolTip="Когда включено — шаг выполняется, если условие НЕ выполнено (OnFailure — если выполнено)"/>
                <TextBlock x:Name="EntryCondSummary" FontSize="11" Foreground="#666"
                           Margin="0,0,0,8" TextWrapping="Wrap" Text="EntryCondition: (нет)"/>
                <StackPanel Orientation="Horizontal" Margin="0,0,0,2">
                    <Button x:Name="EditLoopBtn" Content="✎ LoopUntil…" Padding="8,4"
                            Margin="0,0,6,0" Click="EditLoopBtn_Click"
                            ToolTip="Условие остановки цикла. Пока не выполнено — повторяем до MaxIterations."/>
                    <Button x:Name="ClearLoopBtn" Content="✕" Padding="8,4" Margin="0,0,6,0"
                            Click="ClearLoopBtn_Click" ToolTip="Убрать LoopUntil — цикл идёт до MaxIterations без проверки"/>
                    <Button x:Name="CopyLoopBtn" Content="Копировать" Padding="8,4" Margin="0,0,6,0"
                            Click="CopyLoopBtn_Click" ToolTip="Скопировать LoopUntil в буфер"/>
                    <Button x:Name="PasteLoopBtn" Content="Вставить" Padding="8,4"
                            Click="PasteLoopBtn_Click" ToolTip="Вставить условие из буфера в LoopUntil"/>
                </StackPanel>
                <CheckBox x:Name="LoopNegateChk" Content="НЕ (инвертировать результат)"
                          Margin="0,2,0,4"
                          ToolTip="Когда включено — цикл продолжается, пока условие ВЫПОЛНЕНО (останов — когда не выполнено)"/>
                <TextBlock x:Name="LoopUntilSummary" FontSize="11" Foreground="#666"
                           Margin="0,0,0,12" TextWrapping="Wrap" Text="LoopUntil: (нет)"/>

                <!-- OnSuccess -->
                <TextBlock Text="При успехе (OnSuccess)" FontWeight="SemiBold" Margin="0,0,0,4"/>
                <Grid Margin="0,0,0,6">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="160"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <ComboBox x:Name="SuccessCombo" SelectionChanged="SuccessCombo_SelectionChanged">
                        <ComboBoxItem Content="Next — следующий шаг"/>
                        <ComboBoxItem Content="Done — завершить"/>
                        <ComboBoxItem Content="Abort — прервать"/>
                        <ComboBoxItem Content="Step — перейти к шагу"/>
                    </ComboBox>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="8,0,0,0" VerticalAlignment="Center">
                        <TextBlock x:Name="SuccessStepLbl" Text="Шаг №:" Visibility="Collapsed"
                                   VerticalAlignment="Center" Margin="0,0,4,0"/>
                        <TextBox x:Name="SuccessStepBox" Text="0" Width="48" Visibility="Collapsed" Padding="3,2"/>
                        <TextBox x:Name="SuccessMsgBox" Width="170" Visibility="Collapsed" Padding="3,2"
                                 ToolTip="Сообщение (отображается в статусе при Done/Abort)"/>
                    </StackPanel>
                </Grid>

                <!-- OnFailure -->
                <TextBlock Text="При неудаче (OnFailure)" FontWeight="SemiBold" Margin="0,0,0,4"/>
                <Grid Margin="0,0,0,4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="160"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <ComboBox x:Name="FailureCombo" SelectionChanged="FailureCombo_SelectionChanged">
                        <ComboBoxItem Content="Next — следующий шаг"/>
                        <ComboBoxItem Content="Done — завершить"/>
                        <ComboBoxItem Content="Abort — прервать"/>
                        <ComboBoxItem Content="Step — перейти к шагу"/>
                    </ComboBox>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="8,0,0,0" VerticalAlignment="Center">
                        <TextBlock x:Name="FailureStepLbl" Text="Шаг №:" Visibility="Collapsed"
                                   VerticalAlignment="Center" Margin="0,0,4,0"/>
                        <TextBox x:Name="FailureStepBox" Text="0" Width="48" Visibility="Collapsed" Padding="3,2"/>
                        <TextBox x:Name="FailureMsgBox" Width="170" Visibility="Collapsed" Padding="3,2"
                                 ToolTip="Сообщение"/>
                    </StackPanel>
                </Grid>

            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</Window>
