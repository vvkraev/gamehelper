<Window x:Class="GameHelper.CraftConditionWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Условие остановки крафта"
        Height="580"
        Width="720"
        MinHeight="400"
        MinWidth="560"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False">
    <DockPanel>
        <Grid DockPanel.Dock="Bottom" Margin="12,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <Button Grid.Column="0"
                    Content="Копировать для отчёта…"
                    Padding="8,4"
                    Click="CopyForReport_OnClick"
                    ToolTip="Текущее состояние окна: кратко + JSON — без нажатия OK."/>
            <StackPanel Grid.Column="2"
                        Orientation="Horizontal"
                        HorizontalAlignment="Right">
                <Button Content="OK"
                        Width="96"
                        Padding="8,4"
                        IsDefault="True"
                        Click="Ok_OnClick"/>
                <Button Content="Отмена"
                        Width="96"
                        Padding="8,4"
                        Margin="12,0,0,0"
                        IsCancel="True"
                        Click="Cancel_OnClick"/>
            </StackPanel>
        </Grid>
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="14" x:Name="RootPanel">
                <TextBlock Text="Класс предмета" FontWeight="SemiBold" Margin="0,0,0,4"/>
                <ComboBox x:Name="ItemClassCombo"
                          Margin="0,0,0,10"
                          SelectionChanged="ItemClassCombo_OnSelectionChanged"/>
                <StackPanel x:Name="SubClassRow" Visibility="Collapsed" Margin="0,0,0,10">
                    <TextBlock Text="Тип планшета" FontWeight="SemiBold" Margin="0,0,0,4"/>
                    <ComboBox x:Name="TabletSubClassCombo"
                              SelectionChanged="TabletSubClassCombo_OnSelectionChanged"/>
                </StackPanel>
                <StackPanel x:Name="ArmourSubTypeRow" Visibility="Collapsed" Margin="0,0,0,10">
                    <TextBlock Text="Подтип базы" FontWeight="SemiBold" Margin="0,0,0,4"/>
                    <ComboBox x:Name="ArmourSubTypeCombo"
                              SelectionChanged="ArmourSubTypeCombo_OnSelectionChanged"/>
                </StackPanel>
                <StackPanel x:Name="JewelSubTypeRow" Visibility="Collapsed" Margin="0,0,0,10">
                    <TextBlock Text="Тип джевела" FontWeight="SemiBold" Margin="0,0,0,4"/>
                    <ComboBox x:Name="JewelSubTypeCombo"
                              SelectionChanged="JewelSubTypeCombo_OnSelectionChanged"/>
                </StackPanel>
                <StackPanel x:Name="RuneRow" Visibility="Collapsed" Margin="0,0,0,10">
                    <TextBlock Text="Вставлена руна" FontWeight="SemiBold" Margin="0,0,0,4"/>
                    <ComboBox x:Name="RuneCombo"
                              SelectionChanged="RuneCombo_OnSelectionChanged"
                              ToolTip="Руна, вставленная в гнездо предмета — её аффиксы добавляются в пул крафта"/>
                </StackPanel>
                <Grid Margin="0,0,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="12"/>
                        <ColumnDefinition Width="120"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="Орб (для весового расчёта)" FontWeight="SemiBold" Margin="0,0,0,4"/>
                        <ComboBox x:Name="CraftOrbCombo"
                                  SelectionChanged="CraftOrbCombo_OnSelectionChanged"/>
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                        <TextBlock Text="Item Level" FontWeight="SemiBold" Margin="0,0,0,4"/>
                        <TextBox x:Name="ItemIlvlBox"
                                 TextChanged="ItemIlvlBox_OnTextChanged"
                                 ToolTip="Item level предмета для весового расчёта (0 = не задан)"/>
                    </StackPanel>
                </Grid>
                <TextBlock TextWrapping="Wrap"
                           Foreground="#555"
                           Margin="0,0,0,10"
                           Text="Между «Вариант N» — ИЛИ. Внутри варианта клозы связаны И. «Сумма» — сложение значений (нет модификатора — 0). «Набор (COUNT)» — сколько строк из списка должно выполняться на предмете одновременно (каждая строка как одиночный аффикс)."/>
                <Border x:Name="SelectionToolbar"
                        Visibility="Collapsed"
                        BorderBrush="#1976D2" BorderThickness="1"
                        Background="#E3F2FD"
                        Padding="8,6" Margin="0,0,0,8">
                    <WrapPanel Orientation="Horizontal">
                        <TextBlock x:Name="SelectionInfoLabel"
                                   VerticalAlignment="Center"
                                   Margin="0,0,12,0"/>
                        <Button x:Name="SelectionCopyBtn"
                                Content="Копировать"
                                Padding="8,3" Margin="0,0,8,0"
                                Click="SelectionCopy_Click"/>
                        <Button x:Name="SelectionDeleteBtn"
                                Content="Удалить"
                                Padding="8,3" Margin="0,0,12,0"
                                Click="SelectionDelete_Click"/>
                        <StackPanel x:Name="SelectionMovePanel"
                                    Orientation="Horizontal"
                                    Visibility="Collapsed">
                            <TextBlock Text="Переместить в:"
                                       VerticalAlignment="Center"
                                       Margin="0,0,6,0"/>
                            <ComboBox x:Name="SelectionMoveCombo"
                                      MinWidth="120"
                                      SelectionChanged="SelectionMove_SelectionChanged"/>
                        </StackPanel>
                        <TextBlock x:Name="SelectionWarningLabel"
                                   VerticalAlignment="Center"
                                   Foreground="#C62828"
                                   Visibility="Collapsed"/>
                    </WrapPanel>
                </Border>
                <StackPanel x:Name="OrAlternativesHost" Margin="0,0,0,8"/>
                <TextBlock x:Name="TheoryChanceLabel"
                           Margin="0,0,0,2"
                           FontSize="13"
                           FontWeight="SemiBold"
                           Foreground="#1976D2"/>
                <TextBlock x:Name="PracticeChanceLabel"
                           Margin="0,0,0,6"
                           FontSize="13"
                           FontWeight="SemiBold"
                           Foreground="#388E3C"/>
                <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                    <Button Content="Из буфера: учесть фрактуру"
                            Padding="8,4"
                            Click="DetectFractured_Click"/>
                    <TextBlock x:Name="FracturedInfoLabel"
                               Margin="8,0,0,0"
                               VerticalAlignment="Center"
                               FontSize="12"
                               Foreground="#7B1FA2"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal">
                    <Button Content="Добавить вариант (ИЛИ)…"
                            Padding="10,6"
                            Click="AddOrAlternative_OnClick"/>
                    <Button x:Name="PasteGroupBtn"
                            Content="Вставить вариант"
                            Padding="10,6" Margin="8,0,0,0"
                            Visibility="Collapsed"
                            Click="PasteGroup_Click"/>
                </StackPanel>
            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</Window>
